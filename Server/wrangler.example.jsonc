{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tiboweloveyou-feed",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-07-29",
  "workers_dev": true,
  "kv_namespaces": [
    {
      "binding": "TIBO_STATE",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
